\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sty/Titlepage}[2026/10/08 PAP Titelseite]

\RequirePackage{keyval}

% \cp@t{deutsch}{englisch} ist in sty/Layout.sty definiert (Sprachoption)

% ---------------------------------------------------------------------------
% Standardwerte (werden genutzt, wenn ein Schlüssel nicht an \makecoverpage übergeben wird)
% ---------------------------------------------------------------------------
\newcommand{\cp@pap}{2}
\newcommand{\cp@author}{Matthes Neumann}
\newcommand{\cp@partner}{Theo Senoner}
\newcommand{\cp@university}{\cp@t{Universität Heidelberg}{Heidelberg University}}
\newcommand{\cp@faculty}{\cp@t{Fakultät für Physik und Astronomie}{Faculty of Physics and Astronomy}}
\newcommand{\cp@course}{\cp@t{Physikalisches Anfängerpraktikum}{Introductory Physics Lab Course} \cp@pap{} (PAP\cp@pap)}
\newcommand{\cp@experiment}{}
\newcommand{\cp@title}{}
\newcommand{\cp@group}{}
\newcommand{\cp@tutor}{\rule{4cm}{0.4pt}}
\newcommand{\cp@dateexp}{\rule{4cm}{0.4pt}}
\newcommand{\cp@datesub}{\today}

% ---------------------------------------------------------------------------
% Parameter
% ---------------------------------------------------------------------------
\define@key{coverpage}{pap}{\renewcommand{\cp@pap}{#1}}
\define@key{coverpage}{author}{\renewcommand{\cp@author}{#1}}
\define@key{coverpage}{partner}{\renewcommand{\cp@partner}{#1}}
\define@key{coverpage}{university}{\renewcommand{\cp@university}{#1}}
\define@key{coverpage}{faculty}{\renewcommand{\cp@faculty}{#1}}
\define@key{coverpage}{course}{\renewcommand{\cp@course}{#1}}
\define@key{coverpage}{experiment}{\renewcommand{\cp@experiment}{#1}}
\define@key{coverpage}{title}{\renewcommand{\cp@title}{#1}}
\define@key{coverpage}{group}{\renewcommand{\cp@group}{#1}}
\define@key{coverpage}{tutor}{\renewcommand{\cp@tutor}{#1}}
\define@key{coverpage}{dateexperiment}{\renewcommand{\cp@dateexp}{#1}}
\define@key{coverpage}{datesubmission}{\renewcommand{\cp@datesub}{#1}}

% ---------------------------------------------------------------------------
% \makecoverpage{ key = value , key = value , ... }
% Werte mit Komma müssen in geschweifte Klammern: title={A, B}
% pap (Standard 2), author (Standard Matthes Neumann), partner (Standard Theo Senoner)
% füllen auch die Kopfzeile.
% ---------------------------------------------------------------------------
\newcommand{\makecoverpage}[1]{%
	\setkeys{coverpage}{#1}%
	\begin{titlepage}
		\centering

		{\scshape\large \cp@university \par}
		{\scshape \cp@faculty \par}

		\vspace{1.5cm}

		{\scshape\Large \cp@course \par}

		\vspace{2cm}

		{\huge\bfseries \cp@t{Protokoll zu Versuch}{Report on Experiment} \cp@experiment \par}

		\vspace{0.6cm}

		{\Large\itshape \cp@title \par}

		\vspace{2.5cm}

		\begin{tabular}{rl}
			\textbf{\cp@t{Gruppe}{Group}:}                         & \cp@group \\[4pt]
			\textbf{\cp@t{Autoren}{Authors}:}                      & \begin{tabular}[t]{@{}l@{}}\cp@author \\ \cp@partner\end{tabular} \\[4pt]
			\textbf{\cp@t{Tutor:in}{Tutor}:}                       & \cp@tutor \\[4pt]
			\textbf{\cp@t{Versuchsdatum}{Date of experiment}:}     & \cp@dateexp \\[4pt]
			\textbf{\cp@t{Abgabedatum}{Date of submission}:}       & \cp@datesub \\
		\end{tabular}

		\vfill
	\end{titlepage}%
}
